{
  "$schema": "https://store.greentic.ai/schemas/describe-v1.json",
  "apiVersion": "greentic.ai/v1",
  "kind": "DesignExtension",
  "metadata": {
    "id": "{{id}}",
    "name": "{{name}}",
    "version": "{{version}}",
    "summary": "A Greentic Designer LLM extension.",
    "author": {
      "name": "{{author}}"
    },
    "license": "{{license}}"
  },
  "engine": {
    "greenticDesigner": "^{{contract_version}}",
    "extRuntime": "^{{contract_version}}"
  },
  "capabilities": {
    "offered": [],
    "required": []
  },
  "runtime": {
    "component": "extension.wasm",
    "permissions": {
      "network": ["https://api.example.com/"],
      "secrets": ["api_key"],
      "callExtensionKinds": []
    }
  },
  "contributions": {
    "tools": [
      {
        "id": "complete",
        "name": "complete",
        "description": "Run an LLM completion."
      }
    ]
  }
}
