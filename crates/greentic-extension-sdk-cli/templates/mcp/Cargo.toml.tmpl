[package]
name = "{{name_cargo}}"
version = "{{version}}"
edition = "2024"
license = "{{license}}"
authors = ["{{author}}"]

[lib]
crate-type = ["cdylib"]

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
wit-bindgen-rt = { version = "0.41", features = ["bitflags"] }

[package.metadata.component]
package = "{{id_wit}}"

[package.metadata.component.target]
path = "wit"
world = "mcp-router"

[package.metadata.component.target.dependencies]
"wasix:mcp" = { path = "wit/deps/wasix-mcp" }
