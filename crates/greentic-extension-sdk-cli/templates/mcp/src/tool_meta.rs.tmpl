//! Static metadata for the two MCP tools: names, descriptions, and JSON
//! schemas. Pure (no WIT imports) so the schemas can be asserted by a host
//! test without a wasm build.
//!
//! Replace the placeholder `example_search` / `example_fetch` tools with the
//! real tools your REST API exposes.

pub const EXAMPLE_SEARCH_TOOL: &str = "example_search";
pub const EXAMPLE_FETCH_TOOL: &str = "example_fetch";

const SEARCH_INPUT_SCHEMA: &str = r#"{
  "type": "object",
  "required": ["query"],
  "properties": {
    "query": { "type": "string", "description": "The search query" },
    "max_results": { "type": "integer", "minimum": 1, "maximum": 20, "description": "Number of results (default 5)" }
  }
}"#;

const SEARCH_OUTPUT_SCHEMA: &str = r#"{
  "type": "object",
  "required": ["results", "query"],
  "properties": {
    "query": { "type": "string" },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "url": { "type": "string" },
          "snippet": { "type": "string" }
        }
      }
    }
  }
}"#;

const FETCH_INPUT_SCHEMA: &str = r#"{
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": { "type": "string", "description": "Identifier of the record to fetch" }
  }
}"#;

const FETCH_OUTPUT_SCHEMA: &str = r#"{
  "type": "object",
  "required": ["id", "content"],
  "properties": {
    "id": { "type": "string" },
    "content": { "type": "string" }
  }
}"#;

/// Plain (non-WIT) description of one tool definition.
pub struct ToolMeta {
    pub name: &'static str,
    pub description: &'static str,
    pub input_schema_json: &'static str,
    pub output_schema_json: &'static str,
}

#[must_use]
pub fn example_search_tool() -> ToolMeta {
    ToolMeta {
        name: EXAMPLE_SEARCH_TOOL,
        description: "Search the upstream REST API and return ranked results. The API key is \
                      injected by the host and never returned.",
        input_schema_json: SEARCH_INPUT_SCHEMA,
        output_schema_json: SEARCH_OUTPUT_SCHEMA,
    }
}

#[must_use]
pub fn example_fetch_tool() -> ToolMeta {
    ToolMeta {
        name: EXAMPLE_FETCH_TOOL,
        description: "Fetch a single record from the upstream REST API by id. The API key is \
                      injected by the host and never returned.",
        input_schema_json: FETCH_INPUT_SCHEMA,
        output_schema_json: FETCH_OUTPUT_SCHEMA,
    }
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn tool_names_match_constants() {
        assert_eq!(example_search_tool().name, "example_search");
        assert_eq!(example_fetch_tool().name, "example_fetch");
    }

    #[test]
    fn schemas_are_valid_json() {
        for tool in [example_search_tool(), example_fetch_tool()] {
            serde_json::from_str::<serde_json::Value>(tool.input_schema_json)
                .expect("input schema is valid JSON");
            serde_json::from_str::<serde_json::Value>(tool.output_schema_json)
                .expect("output schema is valid JSON");
        }
    }
}
