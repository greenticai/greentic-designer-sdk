//! Pure response-mapping logic for the MCP tools.
//!
//! Free of WIT/bindings imports so it unit-tests on the host. We deserialize
//! the upstream payloads with permissive structs (unknown fields ignored) and
//! re-serialize the stable shape each tool returns to the agent.

use serde::{Deserialize, Serialize};

#[derive(Debug, Serialize, Deserialize, PartialEq)]
pub struct SearchResult {
    #[serde(default)]
    pub title: String,
    #[serde(default)]
    pub url: String,
    #[serde(default)]
    pub snippet: String,
}

#[derive(Debug, Serialize, Deserialize, PartialEq)]
pub struct SearchOutput {
    #[serde(default)]
    pub query: String,
    #[serde(default)]
    pub results: Vec<SearchResult>,
}

#[derive(Debug, Serialize, Deserialize, PartialEq)]
pub struct FetchOutput {
    #[serde(default)]
    pub id: String,
    #[serde(default)]
    pub content: String,
}

/// Parse an upstream `/search` response body into [`SearchOutput`].
pub fn map_search_response(body: &[u8]) -> Result<SearchOutput, String> {
    serde_json::from_slice::<SearchOutput>(body)
        .map_err(|error| format!("decode search response: {error}"))
}

/// Parse an upstream `/fetch` response body into [`FetchOutput`].
pub fn map_fetch_response(body: &[u8]) -> Result<FetchOutput, String> {
    serde_json::from_slice::<FetchOutput>(body)
        .map_err(|error| format!("decode fetch response: {error}"))
}

#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn maps_search_response_with_results() {
        let raw = br#"{
          "query": "rust",
          "results": [
            {"title": "Rust", "url": "https://rust-lang.org", "snippet": "snippet"}
          ]
        }"#;
        let out = map_search_response(raw).unwrap();
        assert_eq!(out.query, "rust");
        assert_eq!(out.results.len(), 1);
        assert_eq!(out.results[0].url, "https://rust-lang.org");
    }

    #[test]
    fn maps_search_response_without_results() {
        let raw = br#"{"query":"q"}"#;
        let out = map_search_response(raw).unwrap();
        assert!(out.results.is_empty());
    }

    #[test]
    fn search_response_malformed_json_is_err() {
        assert!(map_search_response(b"{not json").is_err());
    }

    #[test]
    fn maps_fetch_response() {
        let raw = br#"{"id":"abc","content":"hello"}"#;
        let out = map_fetch_response(raw).unwrap();
        assert_eq!(out.id, "abc");
        assert_eq!(out.content, "hello");
    }

    #[test]
    fn fetch_response_malformed_json_is_err() {
        assert!(map_fetch_response(b"{bad").is_err());
    }
}
