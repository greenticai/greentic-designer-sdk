//! Multi-tool REST MCP server guest for {{id}}.
//!
//! Mirrors the shipped `component-*-ext` design extensions: this is a
//! `DesignExtension` that exports two agentic-worker tools (`example_search`,
//! `example_fetch`) via `greentic:extension-design/tools`. `list_tools`
//! advertises both; `invoke_tool` dispatches by name and proxies each call to
//! an upstream REST API.
//!
//! All request/response shaping lives in the pure [`input`], [`output`], and
//! [`tool_meta`] modules — they carry no WIT imports, so `cargo test` exercises
//! them on the host. The WIT export layer below is gated behind
//! `#[cfg(target_family = "wasm")]`: the generated `bindings` module only exists
//! under `cargo component build`, and the `export!` macro emits cabi symbols
//! with colons that a host linker rejects.
//!
//! The WASM glue is intentionally thin: deserialize input -> resolve the API key
//! via host `secrets::get` -> call api.example.com via host `http::fetch` -> map
//! the response. Replace the placeholder tools, the `https://api.example.com`
//! base URL, and the secret reference with the real upstream API before
//! shipping.

pub mod input;
pub mod output;
pub mod tool_meta;

#[cfg(target_family = "wasm")]
#[allow(warnings)]
mod bindings;

#[cfg(target_family = "wasm")]
mod guest {
    use super::{input, output, tool_meta};
    use crate::bindings;
    use crate::input::{FetchInput, SearchInput};

    use bindings::exports::greentic::extension_base::{lifecycle, manifest};
    use bindings::exports::greentic::extension_design::tools;
    use bindings::greentic::extension_base::types;
    use bindings::greentic::extension_host::{http, secrets};

    pub struct Component;

    /// Base URL of the upstream REST API. Must match a
    /// `runtime.permissions.network` allowlist entry in describe.json.
    const API_BASE: &str = "https://api.example.com";

    /// Secret URI for the upstream API key. The host resolves this via the
    /// configured secrets backend; the value never leaves this component.
    /// Permission is granted by the `secret://{{runtime_ref_key}}/` prefix entry
    /// in describe.json.
    const API_KEY_REF: &str = "secret://{{runtime_ref_key}}/api_key";

    // ===== extension-base/manifest =====
    impl manifest::Guest for Component {
        fn get_identity() -> types::ExtensionIdentity {
            types::ExtensionIdentity {
                id: "{{id}}".to_string(),
                version: "{{version}}".to_string(),
                kind: types::Kind::Design,
            }
        }

        fn get_offered() -> Vec<types::CapabilityRef> {
            vec![types::CapabilityRef {
                id: "greentic:{{runtime_ref_key}}/search".to_string(),
                version: "1.0.0".to_string(),
            }]
        }

        fn get_required() -> Vec<types::CapabilityRef> {
            Vec::new()
        }
    }

    // ===== extension-base/lifecycle =====
    impl lifecycle::Guest for Component {
        fn init(_config_json: String) -> Result<(), types::ExtensionError> {
            Ok(())
        }

        fn shutdown() {}
    }

    // ===== extension-design/tools =====
    impl tools::Guest for Component {
        fn list_tools() -> Vec<tools::ToolDefinition> {
            [
                tool_meta::example_search_tool(),
                tool_meta::example_fetch_tool(),
            ]
            .into_iter()
            .map(|meta| tools::ToolDefinition {
                name: meta.name.to_string(),
                description: meta.description.to_string(),
                input_schema_json: meta.input_schema_json.to_string(),
                output_schema_json: Some(meta.output_schema_json.to_string()),
            })
            .collect()
        }

        fn invoke_tool(name: String, args_json: String) -> Result<String, types::ExtensionError> {
            match name.as_str() {
                tool_meta::EXAMPLE_SEARCH_TOOL => {
                    let parsed: SearchInput =
                        serde_json::from_str(&args_json).map_err(|error| {
                            types::ExtensionError::InvalidInput(format!(
                                "decode example_search input: {error}"
                            ))
                        })?;
                    let body = input::build_search_body(&parsed)
                        .map_err(types::ExtensionError::InvalidInput)?;
                    let raw = api_request("POST", &format!("{API_BASE}/search"), Some(&body))?;
                    let mapped = output::map_search_response(&raw)
                        .map_err(types::ExtensionError::Internal)?;
                    serde_json::to_string(&mapped).map_err(|error| {
                        types::ExtensionError::Internal(format!("encode output: {error}"))
                    })
                }
                tool_meta::EXAMPLE_FETCH_TOOL => {
                    let parsed: FetchInput = serde_json::from_str(&args_json).map_err(|error| {
                        types::ExtensionError::InvalidInput(format!(
                            "decode example_fetch input: {error}"
                        ))
                    })?;
                    let id = input::build_fetch_id(&parsed)
                        .map_err(types::ExtensionError::InvalidInput)?;
                    let raw = api_request("GET", &format!("{API_BASE}/records/{id}"), None)?;
                    let mapped = output::map_fetch_response(&raw)
                        .map_err(types::ExtensionError::Internal)?;
                    serde_json::to_string(&mapped).map_err(|error| {
                        types::ExtensionError::Internal(format!("encode output: {error}"))
                    })
                }
                other => Err(types::ExtensionError::InvalidInput(format!(
                    "unknown tool: {other}"
                ))),
            }
        }
    }

    /// Resolve the API key, issue an HTTP request to `url`, and return the
    /// response body bytes for a 2xx status. Non-2xx is mapped to an
    /// `ExtensionError` with a message the agent can act on (401/429 called out
    /// explicitly).
    fn api_request(
        method: &str,
        url: &str,
        body: Option<&serde_json::Value>,
    ) -> Result<Vec<u8>, types::ExtensionError> {
        let api_key = secrets::get(API_KEY_REF).map_err(|error| {
            types::ExtensionError::PermissionDenied(format!(
                "resolve secret {API_KEY_REF}: {error}"
            ))
        })?;

        let body_bytes = match body {
            Some(value) => Some(serde_json::to_vec(value).map_err(|error| {
                types::ExtensionError::Internal(format!("encode request body: {error}"))
            })?),
            None => None,
        };

        let request = http::Request {
            method: method.to_string(),
            url: url.to_string(),
            headers: vec![
                ("content-type".to_string(), "application/json".to_string()),
                ("authorization".to_string(), format!("Bearer {api_key}")),
            ],
            body: body_bytes,
        };

        let response = http::fetch(&request)
            .map_err(|error| types::ExtensionError::Internal(format!("http fetch: {error}")))?;

        if (200..300).contains(&response.status) {
            return Ok(response.body);
        }

        let detail = String::from_utf8_lossy(&response.body);
        Err(match response.status {
            401 => types::ExtensionError::PermissionDenied(format!(
                "upstream rejected the API key (401): {detail}"
            )),
            400 | 422 => types::ExtensionError::InvalidInput(format!(
                "upstream rejected the request ({}): {detail}",
                response.status
            )),
            429 => types::ExtensionError::Internal(format!(
                "upstream rate limit exceeded (429): {detail}"
            )),
            status => types::ExtensionError::Internal(format!(
                "upstream request failed ({status}): {detail}"
            )),
        })
    }

    bindings::export!(Component with_types_in bindings);
}
