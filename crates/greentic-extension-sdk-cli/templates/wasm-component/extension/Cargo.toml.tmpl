[package]
name = "{{name_cargo}}-extension"
version = "{{version}}"
edition = "2024"
license = "{{license}}"
authors = ["{{author}}"]

[lib]
crate-type = ["cdylib"]

[dependencies]
wit-bindgen = "0.36"
serde = { version = "1", features = ["derive"] }
serde_json = "1"

[package.metadata.component]
package = "{{id_wit}}"
target = { path = "wit", world = "extension" }
