//! Design-time WASM extension for {{label}}.
//!
//! Bindings come from cargo-component's generated `bindings` module, matching
//! every other `gtdx new` kind. (This template previously used the
//! `wit_bindgen::generate!` macro, which cannot read the grouped
//! `wit/deps/greentic/*` layout the scaffold vendors.)

#[allow(warnings)]
mod bindings;

use bindings::exports::greentic::extension_design::tools;
use bindings::greentic::extension_base::types;

struct Component;

impl tools::Guest for Component {
    fn list_tools() -> Vec<tools::ToolDefinition> {
        vec![
            tools::ToolDefinition {
                name: "validate_config".to_string(),
                description: "Validate a {{label}} node's configuration.".to_string(),
                input_schema_json: r#"{"type":"object"}"#.to_string(),
                output_schema_json: Some(
                    r#"{"type":"object","properties":{"valid":{"type":"boolean"}}}"#.to_string(),
                ),
                // `none` means the consumer defaults capabilities to ["flow"].
                capabilities: None,
                agentic_worker_metadata: None,
            },
            tools::ToolDefinition {
                name: "describe_node".to_string(),
                description: "Describe the {{label}} node type.".to_string(),
                input_schema_json: r#"{"type":"object"}"#.to_string(),
                output_schema_json: None,
                capabilities: None,
                agentic_worker_metadata: None,
            },
        ]
    }

    fn invoke_tool(name: String, args_json: String) -> Result<String, types::ExtensionError> {
        match name.as_str() {
            "validate_config" => Ok(r#"{"valid":true}"#.to_string()),
            "describe_node" => Ok(serde_json::json!({
                "type_id": "{{node_type_id}}",
                "label": "{{label}}",
                "args_received": args_json,
            })
            .to_string()),
            other => Err(types::ExtensionError::InvalidInput(format!(
                "unknown tool: {other}"
            ))),
        }
    }
}

bindings::export!(Component with_types_in bindings);
