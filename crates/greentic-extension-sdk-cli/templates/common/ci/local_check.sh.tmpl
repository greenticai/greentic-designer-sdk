#!/usr/bin/env bash
set -euo pipefail

# Build first. `src/lib.rs` declares `mod bindings;`, and `src/bindings.rs` is
# generated by `cargo component` from the WIT world — it is gitignored and does
# not exist in a fresh checkout, so clippy and tests cannot run before a build.
./build.sh

# Write mode, not `--check`. rustfmt follows `mod bindings;` into the generated
# `src/bindings.rs`, which wit-bindgen does not emit rustfmt-clean; excluding it
# needs rustfmt's nightly-only `ignore` option. Formatting in place keeps your
# own sources tidy without failing on generated code you do not control.
cargo fmt --all

cargo clippy --all-targets -- -D warnings
cargo test
