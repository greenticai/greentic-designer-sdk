// Bundle extension guest for {{id}}.
//
// This scaffold ships one working recipe — `starter` — so a fresh build has
// something to show: the designer lists the recipe and renders its config
// form from the schema below.
//
// `render` is the one export left unimplemented, deliberately. It must return
// the artifact bytes *and* their sha256, and returning a wrong digest is worse
// than returning an error — see the note on that function.

#[allow(warnings)]
mod bindings;

use bindings::exports::greentic::extension_base::{lifecycle, manifest};
use bindings::exports::greentic::extension_bundle::{bundling, recipes};
use bindings::greentic::extension_base::types;

struct Component;

// ---- extension-base/manifest ----
impl manifest::Guest for Component {
    fn get_identity() -> types::ExtensionIdentity {
        types::ExtensionIdentity {
            id: "{{id}}".to_string(),
            version: "{{version}}".to_string(),
            kind: types::Kind::Bundle,
        }
    }

    fn get_offered() -> Vec<types::CapabilityRef> {
        Vec::new()
    }

    fn get_required() -> Vec<types::CapabilityRef> {
        Vec::new()
    }
}

// ---- extension-base/lifecycle ----
impl lifecycle::Guest for Component {
    /// Returning `Err` stops the extension loading at all — reserve it for
    /// configuration that is genuinely unusable.
    fn init(_config_json: String) -> Result<(), types::ExtensionError> {
        Ok(())
    }

    fn shutdown() {
        // Release anything `init` acquired that outlives the component.
    }
}

// ---- extension-bundle/recipes ----
// A recipe is one way this extension can turn a designer session into a
// shippable artifact. The designer lists them and renders their config schema
// as the form the user fills in before bundling.
impl recipes::Guest for Component {
    fn list_recipes() -> Vec<recipes::RecipeSummary> {
        vec![recipes::RecipeSummary {
            id: "starter".to_string(),
            display_name: "Starter bundle".to_string(),
            description: "A minimal recipe to build on.".to_string(),
            // Path inside the pack, e.g. "assets/icon.svg". `None` uses the
            // designer's default icon.
            icon_path: None,
        }]
    }

    /// JSON Schema for the recipe's configuration. The designer renders it as
    /// the bundling form and validates input against it, so a precise schema
    /// here means fewer bad configs reaching `render`.
    fn recipe_config_schema(recipe_id: String) -> Result<String, types::ExtensionError> {
        match recipe_id.as_str() {
            "starter" => Ok(r#"{
                "type": "object",
                "properties": {
                    "bundle_name": {
                        "type": "string",
                        "title": "Bundle name"
                    }
                },
                "required": ["bundle_name"]
            }"#
            .to_string()),
            _ => Err(types::ExtensionError::NotFound(recipe_id)),
        }
    }

    /// Capabilities this recipe can satisfy, as `namespace:name` patterns.
    /// The designer uses them to decide which recipes can bundle a given
    /// session — a session needing `greentic:flows/*` will not offer a recipe
    /// that does not claim it.
    fn supported_capabilities(recipe_id: String) -> Result<Vec<String>, types::ExtensionError> {
        match recipe_id.as_str() {
            "starter" => Ok(vec!["greentic:flows/*".to_string()]),
            _ => Err(types::ExtensionError::NotFound(recipe_id)),
        }
    }
}

// ---- extension-bundle/bundling ----
impl bundling::Guest for Component {
    /// Check the config before `render` runs, so mistakes surface in the form
    /// rather than part-way through building.
    ///
    /// `Severity::Error` blocks bundling; `Warning` lets the user proceed. An
    /// empty list means "looks usable".
    fn validate_config(_recipe_id: String, _config_json: String) -> Vec<types::Diagnostic> {
        Vec::new()
    }

    /// Turn the session into an artifact.
    ///
    /// Left unimplemented on purpose. `BundleArtifact` carries `filename`,
    /// `bytes`, and the **sha256 of those bytes** — consumers verify that
    /// digest, so a placeholder or a wrong hash fails later and further away
    /// than an honest error here. The scaffold ships no hashing crate; add
    /// `sha2` to Cargo.toml, build your bytes, hash them, and return all three
    /// together.
    ///
    /// `session` is the designer state to bundle: read what the recipe needs
    /// from it rather than trusting the config alone.
    fn render(
        recipe_id: String,
        _config_json: String,
        _session: bundling::DesignerSession,
    ) -> Result<bundling::BundleArtifact, types::ExtensionError> {
        Err(types::ExtensionError::Internal(
            ["render not implemented for recipe: ", &recipe_id].concat(),
        ))
    }
}

bindings::export!(Component with_types_in bindings);

// Unit tests run on the host — no WASM, no designer, milliseconds. The guest
// exports are plain Rust functions, so call them directly.
//
// `cargo test` needs `src/bindings.rs`, which is generated. Build once first
// (`gtdx dev --once` or `cargo component build`), then test freely.
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn the_recipe_is_listed() {
        let recipes = <Component as recipes::Guest>::list_recipes();
        assert_eq!(recipes.len(), 1);
        assert_eq!(recipes[0].id, "starter");
    }

    #[test]
    fn the_recipe_has_a_config_schema() {
        let schema = <Component as recipes::Guest>::recipe_config_schema("starter".to_string())
            .expect("starter is implemented");
        assert!(schema.contains("bundle_name"), "got: {schema}");
    }

    /// An id this extension does not own must be refused, not answered with an
    /// empty schema — the designer treats an error as "ask someone else".
    #[test]
    fn an_unknown_recipe_is_an_error() {
        assert!(<Component as recipes::Guest>::recipe_config_schema("nope".to_string()).is_err());
        assert!(<Component as recipes::Guest>::supported_capabilities("nope".to_string()).is_err());
    }
}
