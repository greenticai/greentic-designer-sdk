[package]
name = "{{name_cargo}}"
version = "{{version}}"
edition = "2024"
license = "{{license}}"
authors = ["{{author}}"]

[lib]
crate-type = ["cdylib"]

[dependencies]
serde = { version = "1", features = ["derive"] }
serde_json = "1"
wit-bindgen-rt = { version = "0.41", features = ["bitflags"] }

[dev-dependencies]
# Exercises `plan` against the two properties every addon is held to —
# see `tests::plan_is_idempotent_and_stable` in src/lib.rs. Pinned exactly:
# `assert_plan_idempotent`/`assert_plan_stable` are conformance helpers, not
# yet a stable API, so a version range could silently start passing (or
# failing) this scaffold's own test on an unrelated `cargo update`.
greentic-extension-sdk-testing = "={{sdk_version}}"

[package.metadata.component]
package = "{{id_wit}}"

[package.metadata.component.target]
path = "wit"

[package.metadata.component.target.dependencies]
"greentic:extension-base" = { path = "wit/deps/greentic/extension-base" }
"greentic:extension-host" = { path = "wit/deps/greentic/extension-host" }
"greentic:extension-addon" = { path = "wit/deps/greentic/extension-addon" }
