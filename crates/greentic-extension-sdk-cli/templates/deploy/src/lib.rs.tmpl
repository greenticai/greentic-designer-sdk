// Deploy extension guest for {{id}}.
//
// This scaffold ships one working target — `dry-run` — so a fresh build has
// something to show: the designer lists the target, renders its credential
// and config forms from the schemas below, and the deploy/poll cycle
// completes. It provisions nothing; it exists so you can see the shape of a
// deployment before writing a real one.

// `bindings.rs` is generated by wit-bindgen (via `cargo component build`) and
// is never hand-edited or hand-formatted. `#[rustfmt::skip]` tells rustfmt
// not to descend into it, so `cargo fmt --all -- --check` still passes on a
// freshly scaffolded project, before the first build, when the file doesn't
// exist yet.
#[allow(warnings)]
#[rustfmt::skip]
mod bindings;

use bindings::exports::greentic::extension_base::{lifecycle, manifest};
use bindings::exports::greentic::extension_deploy::{deployment, targets};
use bindings::greentic::extension_base::types;

struct Component;

// ---- extension-base/manifest ----
impl manifest::Guest for Component {
    fn get_identity() -> types::ExtensionIdentity {
        types::ExtensionIdentity {
            id: "{{id}}".to_string(),
            version: "{{version}}".to_string(),
            kind: types::Kind::Deploy,
        }
    }

    fn get_offered() -> Vec<types::CapabilityRef> {
        Vec::new()
    }

    fn get_required() -> Vec<types::CapabilityRef> {
        Vec::new()
    }
}

// ---- extension-base/lifecycle ----
impl lifecycle::Guest for Component {
    fn init(_config_json: String) -> Result<(), types::ExtensionError> {
        // TODO: initialize any state the extension needs.
        Ok(())
    }

    fn shutdown() {
        // TODO: release any resources the extension owns.
    }
}

// ---- extension-deploy/targets ----
// A target is somewhere a bundle can be deployed. The designer lists them and
// renders their schemas as the credential and configuration forms.
impl targets::Guest for Component {
    /// Every target this extension supports.
    ///
    /// `supports_rollback` is a promise: declare `true` only if `rollback`
    /// below can genuinely undo a deployment. The designer offers the button
    /// on the strength of this flag.
    fn list_targets() -> Vec<targets::TargetSummary> {
        vec![targets::TargetSummary {
            id: "dry-run".to_string(),
            display_name: "Dry run".to_string(),
            description: "Validate the request and report success without deploying anything."
                .to_string(),
            icon_path: None,
            supports_rollback: false,
        }]
    }

    /// JSON Schema for the target's credentials. The designer renders it as
    /// the credential form; the runtime injects the stored values at deploy
    /// time. Return the *shape* only, never values.
    fn credential_schema(target_id: String) -> Result<String, types::ExtensionError> {
        match target_id.as_str() {
            // A dry run reaches nothing, so it needs nothing. A real target
            // would describe its API token, subscription id, and so on.
            "dry-run" => Ok(r#"{"type":"object","properties":{}}"#.to_string()),
            _ => Err(types::ExtensionError::NotFound(target_id)),
        }
    }

    /// JSON Schema for per-deployment configuration — region, instance size,
    /// the settings a user picks per environment.
    fn config_schema(target_id: String) -> Result<String, types::ExtensionError> {
        match target_id.as_str() {
            "dry-run" => Ok(r#"{
                "type": "object",
                "properties": {
                    "note": {
                        "type": "string",
                        "title": "Note",
                        "description": "Echoed back in the job message"
                    }
                }
            }"#
            .to_string()),
            _ => Err(types::ExtensionError::NotFound(target_id)),
        }
    }

    /// Check credentials before a deploy is attempted, so a typo surfaces in
    /// the form rather than half-way through provisioning.
    ///
    /// Return `Severity::Error` diagnostics to block, `Warning` to let the
    /// user proceed anyway. An empty list means "looks usable".
    fn validate_credentials(
        _target_id: String,
        _credentials_json: String,
    ) -> Vec<types::Diagnostic> {
        Vec::new()
    }
}

// ---- extension-deploy/deployment ----
// The deploy cycle is asynchronous by design: `deploy` starts work and returns
// a handle, the designer polls until the status settles, and `rollback` undoes
// it if the target supports that.
impl deployment::Guest for Component {
    /// Start a deployment and return a handle immediately. Long work belongs
    /// behind `poll`, not here — the designer expects this call to return
    /// promptly.
    ///
    /// `req` carries the artifact bytes, the resolved credentials, the config,
    /// and the deployment name.
    fn deploy(
        req: deployment::DeployRequest,
    ) -> Result<deployment::DeployJob, types::ExtensionError> {
        match req.target_id.as_str() {
            "dry-run" => Ok(deployment::DeployJob {
                // Your own handle. The designer passes it back to `poll` and
                // `rollback` verbatim, so encode whatever you need to resume.
                id: req.deployment_name.clone(),
                status: deployment::DeployStatus::Running,
                message: ["validated ", &req.deployment_name].concat(),
                // Anything the user can open once the deployment is live.
                endpoints: Vec::new(),
            }),
            other => Err(types::ExtensionError::NotFound(other.to_string())),
        }
    }

    /// Report the current status of `job_id`. The designer calls this
    /// repeatedly until the status reaches a terminal state — `Running`,
    /// `Failed`, or `RolledBack`.
    ///
    /// A status that never settles leaves the UI polling forever, so make sure
    /// every path eventually reaches one of those three.
    fn poll(job_id: String) -> Result<deployment::DeployJob, types::ExtensionError> {
        Ok(deployment::DeployJob {
            id: job_id,
            status: deployment::DeployStatus::Running,
            message: "dry run complete".to_string(),
            endpoints: Vec::new(),
        })
    }

    /// Undo a deployment. Only reachable when the target declared
    /// `supports_rollback: true`, so this stub refuses — matching the `false`
    /// declared above.
    fn rollback(_job_id: String) -> Result<(), types::ExtensionError> {
        Err(types::ExtensionError::Internal(
            "the dry-run target does not support rollback".to_string(),
        ))
    }
}

bindings::export!(Component with_types_in bindings);

// Unit tests run on the host — no WASM, no designer, milliseconds. The guest
// exports are plain Rust functions, so call them directly.
//
// `cargo test` needs `src/bindings.rs`, which is generated. Build once first
// (`gtdx dev --once` or `cargo component build`), then test freely.
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn the_target_is_listed() {
        let targets = <Component as targets::Guest>::list_targets();
        assert_eq!(targets.len(), 1);
        assert_eq!(targets[0].id, "dry-run");
    }

    /// `supports_rollback` is a promise the designer acts on, so the two must
    /// agree: a target that declares `false` has to refuse `rollback`.
    #[test]
    fn rollback_matches_what_the_target_declares() {
        let target = &<Component as targets::Guest>::list_targets()[0];
        assert!(!target.supports_rollback);
        assert!(<Component as deployment::Guest>::rollback("any".to_string()).is_err());
    }

    #[test]
    fn deploy_returns_a_job_that_poll_can_settle() {
        let job = <Component as deployment::Guest>::deploy(deployment::DeployRequest {
            target_id: "dry-run".to_string(),
            artifact_bytes: Vec::new(),
            credentials_json: "{}".to_string(),
            config_json: "{}".to_string(),
            deployment_name: "demo".to_string(),
        })
        .expect("dry-run is implemented");

        let settled = <Component as deployment::Guest>::poll(job.id).expect("poll answers");
        // Terminal, or the designer polls forever.
        assert!(matches!(
            settled.status,
            deployment::DeployStatus::Running
                | deployment::DeployStatus::Failed
                | deployment::DeployStatus::RolledBack
        ));
    }

    #[test]
    fn an_unknown_target_is_an_error() {
        assert!(<Component as targets::Guest>::credential_schema("nope".to_string()).is_err());
    }
}
