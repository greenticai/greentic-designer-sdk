#[allow(warnings)]
mod bindings;

use base64::{Engine as _, engine::general_purpose::STANDARD as B64};
use bindings::exports::greentic::extension_base::{lifecycle, manifest};
use bindings::exports::greentic::extension_design::{knowledge, prompting, tools, validation};
use bindings::greentic::extension_base::types;
use sha2::{Digest, Sha256};

struct Component;

impl manifest::Guest for Component {
    fn get_identity() -> types::ExtensionIdentity {
        types::ExtensionIdentity {
            id: "{{id}}".to_string(),
            version: "{{version}}".to_string(),
            kind: types::Kind::Design,
        }
    }

    fn get_offered() -> Vec<types::CapabilityRef> {
        Vec::new()
    }

    fn get_required() -> Vec<types::CapabilityRef> {
        Vec::new()
    }
}

impl lifecycle::Guest for Component {
    fn init(_config_json: String) -> Result<(), types::ExtensionError> {
        Ok(())
    }

    fn shutdown() {}
}

impl tools::Guest for Component {
    fn list_tools() -> Vec<tools::ToolDefinition> {
        vec![tools::ToolDefinition {
            name: "generate_artifact".to_string(),
            description: "Generate a sample JSON artifact.".to_string(),
            input_schema_json: input_schema_json(),
            output_schema_json: Some(output_schema_json()),
        }]
    }

    fn invoke_tool(name: String, args_json: String) -> Result<String, types::ExtensionError> {
        if name != "generate_artifact" {
            return Err(types::ExtensionError::InvalidInput(format!(
                "unknown tool: {name}"
            )));
        }

        let args: serde_json::Value = serde_json::from_str(&args_json)
            .map_err(|e| types::ExtensionError::InvalidInput(format!("invalid JSON: {e}")))?;
        let artifact_name = args
            .get("name")
            .and_then(|v| v.as_str())
            .filter(|s| !s.trim().is_empty())
            .ok_or_else(|| types::ExtensionError::InvalidInput("name is required".into()))?;
        let kind = args
            .get("kind")
            .and_then(|v| v.as_str())
            .filter(|s| !s.trim().is_empty())
            .unwrap_or("example");

        let bytes = serde_json::to_vec(&serde_json::json!({
            "name": artifact_name,
            "kind": kind
        }))
        .map_err(|e| types::ExtensionError::Internal(format!("artifact JSON: {e}")))?;
        let sha256 = sha256_hex(&bytes);
        let output = serde_json::json!({
            "artifacts": [{
                "kind": kind,
                "filename": "example-artifact.json",
                "media_type": "application/json",
                "sha256": sha256,
                "bytes_base64": B64.encode(&bytes)
            }],
            "diagnostics": [],
            "preview_json": {
                "title": "Example artifact",
                "summary": "Generated by fixture"
            }
        });

        Ok(output.to_string())
    }
}

impl validation::Guest for Component {
    fn validate_content(
        _content_type: String,
        _content_json: String,
    ) -> validation::ValidateResult {
        validation::ValidateResult {
            valid: true,
            diagnostics: Vec::new(),
        }
    }
}

impl prompting::Guest for Component {
    fn system_prompt_fragments() -> Vec<prompting::PromptFragment> {
        Vec::new()
    }
}

impl knowledge::Guest for Component {
    fn list_entries(_category_filter: Option<String>) -> Vec<knowledge::EntrySummary> {
        Vec::new()
    }

    fn get_entry(id: String) -> Result<knowledge::Entry, types::ExtensionError> {
        Err(types::ExtensionError::InvalidInput(format!(
            "unknown entry: {id}"
        )))
    }

    fn suggest_entries(_query: String, _limit: u32) -> Vec<knowledge::EntrySummary> {
        Vec::new()
    }
}

fn input_schema_json() -> String {
    include_str!("../schemas/generate-artifact.input.schema.json").to_string()
}

fn output_schema_json() -> String {
    include_str!("../schemas/artifact-output.schema.json").to_string()
}

fn sha256_hex(bytes: &[u8]) -> String {
    let digest = Sha256::digest(bytes);
    let mut out = String::with_capacity(64);
    for byte in digest {
        use std::fmt::Write as _;
        write!(&mut out, "{byte:02x}").expect("write to string");
    }
    out
}

bindings::export!(Component with_types_in bindings);
