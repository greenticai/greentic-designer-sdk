// Provider extension guest for {{id}}.
//
// This scaffold ships one working channel — `webhook` — so a fresh build has
// something to show: the designer lists the channel, renders its credential
// and config forms from the schemas below, and `dry_run_encode` round-trips a
// sample. Replace it with your real channel rather than starting from a blank
// file.
//
// Two extra steps a provider author must complete before `gtdx publish`:
//
// 1. Replace the bundled `.gtpack` runtime: set
//    `runtime.gtpack.file`/`sha256` in `describe.json` to your real pack.
// 2. If your provider also sources events / sinks them, switch `wit/world.wit`
//    to one of the `*-and-*-provider` or `full-provider` worlds from
//    `wit/deps/greentic/extension-provider/world.wit`, and add the
//    corresponding `impl ... ::Guest for Component` blocks below.

#[allow(warnings)]
mod bindings;

use bindings::exports::greentic::extension_base::{lifecycle, manifest};
use bindings::exports::greentic::extension_provider::messaging;
use bindings::greentic::extension_base::types;
// `Direction`, `CardTier` and the profile records live here — needed as soon
// as `list_channels` returns a real profile. The error type does NOT: the WIT
// declares `extension-error`, which comes from `extension-base/types`.
use bindings::greentic::extension_provider::types as provider_types;

struct Component;

// ---- extension-base/manifest ----
impl manifest::Guest for Component {
    fn get_identity() -> types::ExtensionIdentity {
        types::ExtensionIdentity {
            id: "{{id}}".to_string(),
            version: "{{version}}".to_string(),
            kind: types::Kind::Provider,
        }
    }

    /// Capabilities other extensions may depend on. A provider usually offers
    /// something like `greentic:channels/webhook`; keep this in step with
    /// `capabilities.offered` in describe.json.
    fn get_offered() -> Vec<types::CapabilityRef> {
        Vec::new()
    }

    /// Capabilities this provider needs from others. The designer refuses to
    /// enable an extension whose required capabilities are unmet.
    fn get_required() -> Vec<types::CapabilityRef> {
        Vec::new()
    }
}

// ---- extension-base/lifecycle ----
impl lifecycle::Guest for Component {
    /// `config_json` is this provider's settings, serialised. Returning `Err`
    /// stops the provider loading at all — reserve it for configuration that
    /// is genuinely unusable, not for missing optional values.
    fn init(_config_json: String) -> Result<(), types::ExtensionError> {
        Ok(())
    }

    fn shutdown() {
        // Flush or close whatever `init` set up. Only needed for effects that
        // outlive the component itself.
    }
}

// ---- extension-provider/messaging ----
// A channel is one way this provider can send or receive. The designer lists
// them, renders their schemas as forms, and uses `dry_run_encode` to preview
// an outbound envelope without sending anything.
impl messaging::Guest for Component {
    /// Every channel this provider can talk to.
    ///
    /// `tier_support` says how richly the channel can render a card, best
    /// first: native rendering, then attachment, then a fallback layout, then
    /// plain text. Declaring the honest floor matters — the designer downgrades
    /// content to the best tier a channel actually claims.
    fn list_channels() -> Vec<messaging::ChannelProfile> {
        vec![messaging::ChannelProfile {
            id: "webhook".to_string(),
            display_name: "Webhook".to_string(),
            // `Outbound` sends only. Use `Inbound` for receive-only, or
            // `Bidirectional` when the same channel does both.
            direction: provider_types::Direction::Outbound,
            tier_support: vec![provider_types::CardTier::TierDTextOnly],
            // Free-form hints for the designer UI. Keys are yours to choose.
            metadata: vec![("transport".to_string(), "http".to_string())],
        }]
    }

    /// Look up one channel. Returning `NotFound` for an id you do not own is
    /// correct — the designer treats it as "ask someone else".
    fn describe_channel(id: String) -> Result<messaging::ChannelProfile, types::ExtensionError> {
        Self::list_channels()
            .into_iter()
            .find(|c| c.id == id)
            .ok_or(types::ExtensionError::NotFound(id))
    }

    /// JSON Schema for the channel's *credentials*. The designer renders this
    /// as the "Add credential" form, and the runtime injects the stored values
    /// at execution time.
    ///
    /// Never return the credential values themselves — only their shape.
    fn secret_schema(id: String) -> Result<String, types::ExtensionError> {
        match id.as_str() {
            "webhook" => Ok(r#"{
                "type": "object",
                "properties": {
                    "url": {
                        "type": "string",
                        "title": "Webhook URL",
                        "description": "Where outbound messages are POSTed"
                    }
                },
                "required": ["url"]
            }"#
            .to_string()),
            _ => Err(types::ExtensionError::NotFound(id)),
        }
    }

    /// JSON Schema for per-channel configuration — the non-secret settings a
    /// user tunes per deployment.
    fn config_schema(id: String) -> Result<String, types::ExtensionError> {
        match id.as_str() {
            "webhook" => Ok(r#"{
                "type": "object",
                "properties": {
                    "timeout_seconds": {
                        "type": "integer",
                        "title": "Timeout (seconds)",
                        "default": 10
                    }
                }
            }"#
            .to_string()),
            _ => Err(types::ExtensionError::NotFound(id)),
        }
    }

    /// Encode `sample` as this channel's outbound envelope, without sending
    /// it. The designer uses this for preview, so it must stay side-effect
    /// free: no network, no writes.
    fn dry_run_encode(id: String, sample: Vec<u8>) -> Result<Vec<u8>, types::ExtensionError> {
        match id.as_str() {
            // This channel POSTs the payload unchanged, so the envelope is the
            // sample. A real channel would wrap it — JSON body, form fields,
            // whatever the far end expects.
            "webhook" => Ok(sample),
            _ => Err(types::ExtensionError::NotFound(id)),
        }
    }
}

bindings::export!(Component with_types_in bindings);

// Unit tests run on the host — no WASM, no designer, milliseconds. The guest
// exports are plain Rust functions, so call them directly.
//
// `cargo test` needs `src/bindings.rs`, which is generated. Build once first
// (`gtdx dev --once` or `cargo component build`), then test freely.
#[cfg(test)]
mod tests {
    use super::*;

    #[test]
    fn the_channel_is_listed_and_describable() {
        let channels = <Component as messaging::Guest>::list_channels();
        assert_eq!(channels.len(), 1);
        assert_eq!(channels[0].id, "webhook");
        // list and describe must agree, or the designer shows one thing and
        // resolves another.
        let described = <Component as messaging::Guest>::describe_channel("webhook".to_string())
            .expect("webhook is implemented");
        assert_eq!(described.id, channels[0].id);
    }

    #[test]
    fn the_channel_declares_its_schemas() {
        let secret = <Component as messaging::Guest>::secret_schema("webhook".to_string())
            .expect("webhook is implemented");
        assert!(secret.contains("url"), "got: {secret}");
        assert!(<Component as messaging::Guest>::config_schema("webhook".to_string()).is_ok());
    }

    /// `dry_run_encode` powers preview, so it must be pure: same input, same
    /// output, no side effects.
    #[test]
    fn dry_run_encode_round_trips() {
        let sample = b"hello".to_vec();
        let encoded =
            <Component as messaging::Guest>::dry_run_encode("webhook".to_string(), sample.clone())
                .expect("webhook is implemented");
        assert_eq!(encoded, sample);
    }

    #[test]
    fn an_unknown_channel_is_an_error() {
        assert!(<Component as messaging::Guest>::describe_channel("nope".to_string()).is_err());
    }
}
